      "quoted_author": "",
      "quoted_handle": ""
    },
    {
      "id": "2126536403345400001",
      "text": "An important 3 from Grimes off Luka's penetration into the middle of the paint, followed by Grimes drawing an offensive foul on a Kornet screen that Luka converted with a 2 has LA back within 3 out of the time out.",
      "url": "https://x.com/LakersReporter/status/2126536403345400001",
      "published": "2026-11-28T04:39:22+00:00",
      "likes": 102,
      "author": "Mike Trudell",
      "handle": "LakersReporter",
      "avatar": "https://pbs.twimg.com/profile_images/524367536763056130/32h6Ng8Y_normal.jpeg",
      "media": "",
      "quoted_text": "",
      "quoted_author": "",
      "quoted_handle": ""
    },
    {
      "id": "2126536245841158343",
      "text": "Luka returns and finds Grimes for an open triple out of the timeout!",

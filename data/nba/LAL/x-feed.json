    {
      "id": "2123478476506206591",
      "text": "JJ Redick revealed the #Lakers are managing Adou Thiero's minutes throughout the season. https://t.co/5KYqO8Hsdf",
      "url": "https://x.com/LakersNation/status/2123478476506206591",

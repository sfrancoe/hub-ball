    {
      "id": "2123279507495002340",
      "text": "Matisse Thybulle has grabbed 3+ steals in seven-straight games, the longest such streak of his career 😎",
      "url": "https://x.com/Lakers/status/2123279507495002340",
      "published": "2026-11-19T04:57:37+00:00",
      "likes": 1509,
      "author": "Los Angeles Lakers",

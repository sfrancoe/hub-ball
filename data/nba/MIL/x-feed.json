      "avatar": "https://pbs.twimg.com/profile_images/1484397622085533699/gkUrv5pP_normal.jpg",
      "media": "",
      "quoted_text": "@fmaddenNBA One of the worst signings in #Bucks history",
      "quoted_author": "WSRanter",
      "quoted_handle": "WSRanter"

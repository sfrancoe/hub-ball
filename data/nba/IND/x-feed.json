      "quoted_handle": ""
    },
    {
      "id": "2124695151163682950",
      "text": "Pacers getting some of the best offensive glass production we've seen all year in this stretch. Zubac putback makes it a three-point game.",
      "url": "https://x.com/DustinDopirak/status/2124695151163682950",
      "published": "2026-11-23T02:42:53+00:00",
      "likes": 3,
      "author": "Dustin Dopirak",
      "handle": "DustinDopirak",

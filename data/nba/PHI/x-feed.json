    {
      "id": "2126507175413706821",
      "text": "LeBron scores on an eight-footer with 7:30 to give the Sixers a 101-70 lead. The baskets gives him 21 points, marking his fifth straight game with at least 21 points.",
      "url": "https://x.com/PompeyOnSixers/status/2126507175413706821",
      "published": "2026-11-28T02:43:13+00:00",
      "likes": 16,
      "author": "Keith Pompey",
      "handle": "PompeyOnSixers",
      "avatar": "https://pbs.twimg.com/profile_images/1316820369379127296/ANrCuQgt_normal.jpg",
      "media": "",
      "quoted_text": "LeBron James is one point shy of scoring 20-plus points for the fifth consecutive game.",
      "quoted_author": "Keith Pompey",
      "quoted_handle": "PompeyOnSixers"
    },
    {
      "id": "2126504272900600054",
      "text": "Sixers lead 85-58 after three quarters. Simons scored 12 of his points in the quarter.",

    {
      "id": "2123386207979946200",
      "text": "Eight is enough: Dybantsa, Davis power Wizards to win over depleted Raptors https://t.co/G25PjIMfpb",
      "url": "https://x.com/BulletsForever/status/2123386207979946200",
      "published": "2026-11-19T12:01:37+00:00",
      "likes": 1,
      "author": "Bullets Forever",
      "handle": "BulletsForever",
      "avatar": "https://pbs.twimg.com/profile_images/1425664887603204096/oBZvR-NX_normal.jpg",
      "media": "",
      "quoted_text": "",
      "quoted_author": "",

      "published": "2026-11-22T19:17:48+00:00",
      "likes": 12,
      "author": "Luke Johnson",
      "handle": "ByLukeJohnson",
      "avatar": "https://pbs.twimg.com/profile_images/1819219584886755328/6SnGhjbz_normal.jpg",
      "media": "",
      "quoted_text": "The Saints actually broke an explosive run and I couldn't believe they did it, 46 yards by Travis Etienne",
      "quoted_author": "Luke Johnson",
      "quoted_handle": "ByLukeJohnson"
    },

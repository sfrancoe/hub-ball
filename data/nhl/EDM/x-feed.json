      "avatar": "https://pbs.twimg.com/profile_images/1721774684491116544/6SoILkIp_normal.jpg",
      "media": "https://pbs.twimg.com/media/HXIr4DpaAAAt4Up.jpg",
      "quoted_text": "",
      "quoted_author": "",

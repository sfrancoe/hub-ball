      "author": "Minnesota Wild PR",
      "handle": "mnwildPR",
      "avatar": "https://pbs.twimg.com/profile_images/1418220316577259533/PlawH8Rd_normal.jpg",
      "media": "",
      "quoted_text": "The #mnwild has now won seven consecutive road games, tied for the longest run in the NHL this season (Edmonton). Six of Minnesota's seven wins during the streak have come by two goals or more.",
      "quoted_author": "Minnesota Wild PR",
      "quoted_handle": "mnwildPR"
    },

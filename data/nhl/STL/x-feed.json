      "quoted_handle": ""
    },
    {
      "id": "2122923644598816902",
      "text": "Jim Montgomery: \"D-men were on their toes, forwards were on their toes, we had two on the inside, we recovered a lot of shots that went wayward or rebounds, we recovered a lot, probably the most this year. That was really good.\" #stlblues",
      "url": "https://x.com/lkorac10/status/2122923644598816902",
      "published": "2026-11-18T05:23:33+00:00",
      "likes": 12,
      "author": "Lou Korac",

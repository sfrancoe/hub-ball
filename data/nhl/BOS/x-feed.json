    {
      "id": "2119999485992718474",
      "text": "\"To the fans and the City of Boston, thank you for welcoming me and standing behind me throughout my career. It was an absolute privilege to play in front of you for two decades. Thank you for your passion and for making this journey so special.\" -- Patrice Bergeron https://t.co/SVkAm8GXS7",
      "url": "https://x.com/NHLBruins/status/2119999485992718474",
      "published": "2026-11-10T03:43:59+00:00",
      "likes": 1880,
      "author": "Boston Bruins",
      "handle": "NHLBruins",
      "avatar": "https://pbs.twimg.com/profile_images/2120592543909924864/kXR5gSZg_normal.jpg",

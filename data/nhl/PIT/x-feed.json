      "likes": 2,
      "author": "Dan Kingerski",
      "handle": "TheDanKingerski",
      "avatar": "https://pbs.twimg.com/profile_images/1942196553285791744/FbFAD-Az_normal.jpg",
      "media": "",
      "quoted_text": "Wyatt Johnston spun TVR right round at the blue line, had acres of space. Kiviranta beat Letang to the net. An honest goal and not gifted. 1-0 Dallas.",
      "quoted_author": "Dan Kingerski",
      "quoted_handle": "TheDanKingerski"
    },

    {
      "id": "2125062534084407573",
      "text": "Sorokin to bench with 2:11 to go in the third, down 3-2. #Isles",
      "url": "https://x.com/stefen_rosner/status/2125062534084407573",
      "published": "2026-11-24T03:02:44+00:00",

    },
    {
      "id": "2125062640179564696",
      "text": "Leafs empty netter and it's 4-2 as #Isles headed to a brutal, brutal defeat.",
      "url": "https://x.com/AGrossNewsday/status/2125062640179564696",
      "published": "2026-11-24T03:03:09+00:00",

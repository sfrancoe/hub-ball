      "quoted_handle": ""
    },
    {
      "id": "2125062301283696828",
      "text": "Horvat and Barzal getting shifts together with #Isles trailing late in the third period.",
      "url": "https://x.com/stefen_rosner/status/2125062301283696828",
      "published": "2026-11-24T03:01:49+00:00",
      "likes": 11,
      "author": "Stefen Rosner",

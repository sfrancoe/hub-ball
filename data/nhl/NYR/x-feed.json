    {
      "id": "2121438787976761543",
      "text": "Hard to say for sure who it was directed at, but Miller was definitely barking at someone after the goal.",
      "url": "https://x.com/vzmercogliano/status/2121438787976761543",
      "published": "2026-11-14T03:03:16+00:00",
      "likes": 21,

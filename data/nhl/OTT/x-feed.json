    {
      "id": "2124333312311259367",
      "text": "Kevin Fiala slashed Linus Ullmark's glove hand as he was covering up the puck.",
      "url": "https://x.com/jkamckenzie/status/2124333312311259367",
      "published": "2026-11-22T02:45:04+00:00",
      "likes": 27,
      "author": "Julian McKenzie",
      "handle": "jkamckenzie",
      "avatar": "https://pbs.twimg.com/profile_images/1876308715290099712/zRCV8R57_normal.jpg",
      "media": "",
      "quoted_text": "",
      "quoted_author": "",
      "quoted_handle": ""
    },
    {
      "id": "2124332525887602742",
      "text": "Ray Bourque holds the record for most shots on goal in a game with 19(!!) Brady Tkachuk, on two occasions, had 12 SOGs in a game.",
      "url": "https://x.com/jkamckenzie/status/2124332525887602742",
      "published": "2026-11-22T02:41:57+00:00",
      "likes": 20,
      "author": "Julian McKenzie",
      "handle": "jkamckenzie",
      "avatar": "https://pbs.twimg.com/profile_images/1876308715290099712/zRCV8R57_normal.jpg",
      "media": "",
      "quoted_text": "That last shot on goal was Ridly Greig's 10th of the game.",
      "quoted_author": "Julian McKenzie",
      "quoted_handle": "jkamckenzie"
    },
    {
      "id": "2124331887317438649",
      "text": "That last shot on goal was Ridly Greig's 10th of the game.",
      "url": "https://x.com/jkamckenzie/status/2124331887317438649",
      "published": "2026-11-22T02:39:24+00:00",
      "likes": 27,
      "author": "Julian McKenzie",
      "handle": "jkamckenzie",
      "avatar": "https://pbs.twimg.com/profile_images/1876308715290099712/zRCV8R57_normal.jpg",
      "media": "",
      "quoted_text": "",
      "quoted_author": "",
      "quoted_handle": ""
    },
    {
      "id": "2124331183127617540",
      "text": "Ridly Greig has 9 shots today and that's not including a breakaway attempt that missed the net.",
      "url": "https://x.com/AlexAdamsCIH/status/2124331183127617540",
      "published": "2026-11-22T02:36:36+00:00",
      "likes": 45,
      "author": "Alex Adams",
      "handle": "AlexAdamsCIH",
      "avatar": "https://pbs.twimg.com/profile_images/1936436189159956480/_5lR5VjJ_normal.jpg",
      "media": "",
      "quoted_text": "Ridly Greig has six shots this game and we aren't done the 1st period.",
      "quoted_author": "Alex Adams",
      "quoted_handle": "AlexAdamsCIH"
    },
    {
      "id": "2124331061383418178",
      "text": "Was hoping for another Ridly Greig clapper there.",
      "url": "https://x.com/GraemeNichols/status/2124331061383418178",

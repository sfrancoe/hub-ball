    {
      "id": "2122924107109171615",
      "text": "The Stars get that one right back. Nils Lundkvist sneaks down to the bottom of the circle and Mikko Rantanen finds him. 2-1 #VGK",
      "url": "https://x.com/RyanHockeyGuy/status/2122924107109171615",
      "published": "2026-11-18T05:25:23+00:00",
      "likes": 4,
      "author": "Ryan The Hockey Guy",

      "quoted_handle": ""
    },
    {
      "id": "2122923733597946313",
      "text": "2-0, Karlsson VGK PP comes to an end, but Trevor Connelly bats the puck down in the slot and slides it over to 71 #VegasBorn",
      "url": "https://x.com/VinceSapienza/status/2122923733597946313",
      "published": "2026-11-18T05:23:54+00:00",
      "likes": 4,
      "author": "Vince Sapienza",

      "media": "",
      "quoted_text": "",
      "quoted_author": "",
      "quoted_handle": ""
    },
    {
      "id": "2122923608658121213",
      "text": "The Trevor Connelly show continues! Awesome read to take a puck away in the low slot then has the patience and vision to move it to Karlsson once again. VGK are up a pair based both on #24's beautiful passes. 2-0 VGK",
      "url": "https://x.com/SinBinVegas/status/2122923608658121213",
      "published": "2026-11-18T05:23:24+00:00",
      "likes": 68,
      "author": "SinBin.vegas",

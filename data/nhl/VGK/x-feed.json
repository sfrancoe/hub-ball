      "quoted_text": "",
      "quoted_author": "",
      "quoted_handle": ""
    },
    {
      "id": "2120717083407421526",
      "text": "Marc Gatcomb does something every three games where I can't believe it's him on the ice, and it just happened again.",
      "url": "https://x.com/DannyWebster21/status/2120717083407421526",
      "published": "2026-11-12T03:15:28+00:00",

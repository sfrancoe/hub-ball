    {
      "id": "2122157385720451329",
      "text": "Oilers take a 4-2 lead early in the third period. Just as the Flyers fifth power-play died, Leon Draisaitl blasts straight up ice past Travis Sanheim and beats Vladar under his blocker. Offensive zone by Travis Konecny on a pass intended for Sanheim started the play the other",
      "url": "https://x.com/AnthonyMingioni/status/2122157385720451329",
      "published": "2026-11-16T02:38:43+00:00",
      "likes": 0,
      "author": "Anthony Mingioni",
      "handle": "AnthonyMingioni",
      "avatar": "https://pbs.twimg.com/profile_images/1759626101171597312/AZVSgTb0_normal.jpg",
      "media": "",
      "quoted_text": "",
      "quoted_author": "",
      "quoted_handle": ""
    },
    {
      "id": "2122157240828428653",
      "text": "At 1:07, Draisaitl breakaway off Konecny turnover, 4-2.",
      "url": "https://x.com/waynefish1/status/2122157240828428653",
      "published": "2026-11-16T02:38:08+00:00",
      "likes": 0,
      "author": "wayne fish",

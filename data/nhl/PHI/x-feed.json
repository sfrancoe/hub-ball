      "media": "",
      "quoted_text": "",
      "quoted_author": "",
      "quoted_handle": ""
    },
    {
      "id": "2122157154228670679",
      "text": "Leon Draisaitl strikes again. He picked off a pass by Travis Konecny and took it the other way.",
      "url": "https://x.com/JHallNBCS/status/2122157154228670679",
      "published": "2026-11-16T02:37:47+00:00",
      "likes": 8,
      "author": "Jordan Hall",
